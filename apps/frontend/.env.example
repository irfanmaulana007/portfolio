# Frontend environment (copy to .env.local for local dev)

# Backend API base URL used by the browser (contact form POST).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Optional server-only base URL for SSR/ISR project fetching.
# Falls back to NEXT_PUBLIC_API_BASE_URL when unset. In Docker/Dokploy this can
# point at the internal service URL (e.g. http://portfolio-backend:3001).
# API_BASE_URL=http://localhost:3001

# Sentry error/performance monitoring (optional).
# The DSN is a public, non-secret identifier and is inlined into the browser
# bundle at build time (pass it as a Docker build arg). Leave unset to disable
# Sentry entirely — the SDK no-ops when this is absent.
# NEXT_PUBLIC_SENTRY_DSN=https://eac9ff0ae3f92a5451fc0f04be9cbe84@o4509683278741504.ingest.us.sentry.io/4512388730454016
