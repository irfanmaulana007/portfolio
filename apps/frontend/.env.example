# Frontend environment (copy to .env.local for local dev)

# Backend API base URL used by the browser (contact form POST).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Optional server-only base URL for SSR/ISR project fetching.
# Falls back to NEXT_PUBLIC_API_BASE_URL when unset. In Docker/Dokploy this can
# point at the internal service URL (e.g. http://portfolio-backend:3001).
# API_BASE_URL=http://localhost:3001

# Sentry error/performance monitoring (optional).
# The DSN is a public, non-secret identifier, inlined into the browser bundle at
# build time (pass it as a Docker build arg). Leave unset to disable Sentry —
# the SDK no-ops when absent. Set the REAL DSN in your deploy env (Dokploy build
# arg), NOT here: a real value copied into a local .env would report dev/CI
# errors to the production Sentry project. Placeholder shape only:
# NEXT_PUBLIC_SENTRY_DSN=https://<public-key>@o<org-id>.ingest.us.sentry.io/<project-id>
