# Backend environment (copy to .env for local dev)

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio

# JWT signing secret — use a long random value in production
JWT_SECRET=change-me-to-a-long-random-secret
# Token lifetime in seconds (default 8h)
JWT_EXPIRES_IN=28800

# Seed admin credentials (used by `pnpm db:seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Comma-separated allowed CORS origins (frontend + admin).
# REQUIRED in production — the server refuses to start if empty when NODE_ENV=production
# (it never reflects arbitrary origins).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Reverse-proxy hop count for req.ip (rate limiting / stored IPs). Default 1
# (single proxy, e.g. Dokploy). Use a higher count behind multiple proxies
# (e.g. Cloudflare + Traefik = 2), or `false` if the app is exposed directly.
TRUST_PROXY=1

# HTTP port
PORT=3001

NODE_ENV=development

# Sentry error/performance monitoring (optional).
# The DSN is a public, non-secret identifier. Leave unset to disable Sentry —
# the SDK no-ops when absent. `environment` is taken from NODE_ENV above. Set the
# REAL DSN in your deploy env (Dokploy runtime env), NOT here: a real value
# copied into a local .env would report dev errors to the production Sentry
# project. Placeholder shape only:
# SENTRY_DSN=https://<public-key>@o<org-id>.ingest.us.sentry.io/<project-id>
