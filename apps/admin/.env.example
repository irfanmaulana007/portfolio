# Admin app environment (copy to .env for local dev)

# Backend API base URL
VITE_API_BASE_URL=http://localhost:3001

# Sentry error/performance monitoring (optional).
# The DSN is a public, non-secret identifier and is inlined into the bundle at
# build time (pass it as a Docker build arg). Leave unset to disable Sentry
# entirely — the SDK no-ops when this is absent.
# VITE_SENTRY_DSN=https://120bf8c404d7ed1e96b9b89cf2f643dd@o4509683278741504.ingest.us.sentry.io/4512388730978304
