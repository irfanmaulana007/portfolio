# Admin app environment (copy to .env for local dev)

# Backend API base URL
VITE_API_BASE_URL=http://localhost:3001

# Sentry error/performance monitoring (optional).
# The DSN is a public, non-secret identifier, inlined into the bundle at build
# time (pass it as a Docker build arg). Leave unset to disable Sentry — the SDK
# no-ops when absent. Set the REAL DSN in your deploy env (Dokploy build arg),
# NOT here: a real value copied into a local .env would report dev/CI errors to
# the production Sentry project. Placeholder shape only:
# VITE_SENTRY_DSN=https://<public-key>@o<org-id>.ingest.us.sentry.io/<project-id>
