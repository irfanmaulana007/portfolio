{
  "name": "portfolio-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:frontend": "pnpm --filter @portfolio/frontend dev",
    "dev:backend": "pnpm --filter @portfolio/backend dev",
    "dev:admin": "pnpm --filter @portfolio/admin dev",
    "build": "pnpm -r build",
    "build:frontend": "pnpm --filter @portfolio/frontend build",
    "build:backend": "pnpm --filter @portfolio/backend build",
    "build:admin": "pnpm --filter @portfolio/admin build",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @portfolio/backend db:migrate",
    "db:seed": "pnpm --filter @portfolio/backend db:seed",
    "db:generate": "pnpm --filter @portfolio/backend db:generate"
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  }
}
